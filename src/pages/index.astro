---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ResumeButton from '../components/ResumeButton.astro';
import CareerMap from '../components/CareerMap.astro';
import KpiGrid from '../components/KpiGrid.astro';
import Story from '../components/Story.astro';
import Timeline from '../components/Timeline.astro';
import ProjectExplorer from '../components/ProjectExplorer.astro';
import SkillsMatrix from '../components/SkillsMatrix.astro';
import Experience from '../components/Experience.astro';
import Credentials from '../components/Credentials.astro';
import Contact from '../components/Contact.astro';
import { site } from '../config/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Business Intelligence Developer',
  description: site.headline,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Vancouver', addressCountry: 'CA' },
  sameAs: [site.links.linkedin, site.links.github],
  knowsAbout: ['Business intelligence', 'Power BI', 'Microsoft Fabric', 'Data modeling', 'ETL', 'SQL', 'DAX', 'Python'],
};
---

<Base jsonLd={jsonLd}>
  <section class="section" id="overview" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="panel hero">
        <span class="kicker">{site.eyebrow}</span>
        <h1 id="hero-title">{site.name}</h1>
        <p class="lead">{site.lead}</p>
        <p class="intro">{site.intro}</p>

        <ul class="problems" aria-label="Problems I solve">
          {site.problems.map((p) => <li>{p}</li>)}
        </ul>

        <div class="meta-row">
          <span><Icon name="pin" />{site.location}</span>
          <span><Icon name="laptop" />{site.workArrangement}</span>
          <span><Icon name="mail" /><a href={`mailto:${site.email}`}>{site.email}</a></span>
        </div>

        <div class="cta-row">
          <a class="btn btn-primary" href="#projects">
            See the case studies
            <Icon name="arrow" />
          </a>
          <ResumeButton variant="ghost" />
          <a class="btn" href={site.links.linkedin} target="_blank" rel="noopener noreferrer">
            <Icon name="linkedin" />
            LinkedIn<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a class="btn" href={site.links.github} target="_blank" rel="noopener noreferrer">
            <Icon name="github" />
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>

        <div class="roles-row" aria-label="Roles I am open to">
          <span class="label">Open to</span>
          {site.targetRoles.map((r) => <span class="tag">{r}</span>)}
        </div>
      </div>

      <CareerMap />
    </div>

    <div class="container" style="margin-top:1rem">
      <KpiGrid />
    </div>
  </section>

  <section class="section" id="story" aria-labelledby="story-title">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Career story</span>
        <h2 class="h2" id="story-title">From glass-plant data to Microsoft Fabric</h2>
        <p>Four roles in the same direction: each one moved me closer to owning the full path from raw data to a decision.</p>
      </header>
      <Story />
      <div style="margin-top:1rem">
        <Timeline />
      </div>
    </div>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Case studies</span>
        <h2 class="h2" id="projects-title">Projects, told as problems and results</h2>
        <p>
          Each case study covers the situation, the challenge, what I owned versus what the team did, how I
          approached it and what came out of it. Filter by type or by tool.
        </p>
      </header>
      <ProjectExplorer />
    </div>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-heading">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Skills</span>
        <h2 class="h2" id="skills-heading">What I use, and where I've used it</h2>
        <p>Every dot points to documented work, so you can see how long and in what setting I've used each skill.</p>
      </header>
      <SkillsMatrix />
    </div>
  </section>

  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Experience</span>
        <h2 class="h2" id="exp-title">Where I did the work</h2>
        <p>A short version that complements the resume. The full detail is in the downloadable resume.</p>
      </header>
      <Experience />
    </div>
  </section>

  <section class="section" id="credentials" aria-labelledby="cred-title">
    <div class="container">
      <header class="section-head">
        <span class="kicker">Credentials</span>
        <h2 class="h2" id="cred-title">Publications, education and recognition</h2>
      </header>
      <Credentials />
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <Contact />
    </div>
  </section>
</Base>
