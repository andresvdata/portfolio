---
import Icon from './Icon.astro';
import { site } from '../config/site';
interface Props { variant?: 'primary' | 'ghost'; hideIfMissing?: boolean }
const { variant = 'primary', hideIfMissing = false } = Astro.props;
const cls = variant === 'primary' ? 'btn btn-primary' : 'btn';
---

{
  site.resumeUrl ? (
    <a class={cls} href={site.resumeUrl} target="_blank" rel="noopener noreferrer">
      <Icon name="file" />
      Resume<span class="sr-only"> (opens in a new tab)</span>
    </a>
  ) : hideIfMissing ? null : (
    <span class="btn need" role="note">
      <Icon name="file" />
      <span class="need-tag">Need detail</span>Add resume link in src/config/site.ts
    </span>
  )
}
