---
import { getCollection } from 'astro:content';
import { focusAttrs } from '../lib/focus';
const items = await getCollection('highlights');
---

<ul class="kpi-grid" aria-label="Highlights" data-f-group>
  {items.map((k) => (
    <li class="kpi" {...focusAttrs({ kind: 'kpi', topics: k.data.topics, tools: k.data.tools })}>
      <span class="kpi-value">{k.data.value}</span>
      <span class="kpi-label">{k.data.label}</span>
      <span class="kpi-context">{k.data.context}</span>
      {k.data.bar && (
        <span
          class="kpi-bar"
          aria-hidden="true"
          title={k.data.bar.kind === 'fill' ? 'Share replaced' : 'Time remaining after the change'}
        >
          <span style={`width:${k.data.bar.value}%`}></span>
        </span>
      )}
    </li>
  ))}
</ul>
<p class="f-empty" data-f-empty="kpi" hidden>No highlight matches this filter.</p>
