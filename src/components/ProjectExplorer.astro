---
import { getCollection } from 'astro:content';
import { rich, typeLabel, withBase } from '../lib/text';
import { getProjects } from '../lib/projects';
import { focusAttrs } from '../lib/focus';

const projects = await getProjects();
const more = (await getCollection('more')).sort((a, b) => a.data.order - b.data.order);
---

<div data-explorer>
  <h3 class="sr-only">Featured case studies</h3>
  <div class="cards" data-f-group>
    {projects.map((p) => (
      <article class="card" {...focusAttrs({ kind: 'projects', topics: p.data.topics, from: p.data.tags, type: p.data.type })}>
        <div class="card-top">
          <span class="badge" data-type={p.data.type}>{typeLabel[p.data.type]}</span>
          <span class="org">{p.data.period}</span>
        </div>
        <h3><a href={withBase(`/projects/${p.id}/`)}>{p.data.title}</a></h3>
        <span class="org">{p.data.org}</span>
        <p>{p.data.summary}</p>
        {p.data.metric && (
          <div class="card-metric">
            <strong>{p.data.metric.value}</strong>
            <span>{p.data.metric.label}</span>
          </div>
        )}
        <div class="tag-row">
          {p.data.tags.slice(0, 5).map((t) => <span class="tag">{t}</span>)}
        </div>
        <span class="card-link" aria-hidden="true">Read the case study →</span>
      </article>
    ))}
  </div>

  <div data-f-group>
  <h3 class="more-head panel-title">More projects</h3>
  <div class="more-list">
    {more.map((m) => (
      <article class="more-item" id={`more-${m.id}`} {...focusAttrs({ kind: 'more', topics: m.data.topics, from: m.data.tags, type: m.data.type })}>
        <div>
          <div class="top">
            <span class="badge" data-type={m.data.type}>{typeLabel[m.data.type]}</span>
            <span class="tag">{m.data.period}</span>
          </div>
          <h4>{m.data.title}</h4>
          <p set:html={rich(m.data.blurb)} />
          {m.data.details.length > 0 && (
            <ul class="more-details">
              {m.data.details.map((d) => <li set:html={rich(d)} />)}
            </ul>
          )}
          <div class="tag-row" style="margin-top:0.5rem">
            {m.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </div>
        {m.data.links.length > 0 && (
          <div class="links">
            {m.data.links.map((l) => (
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}<span class="sr-only"> (opens in a new tab)</span>
              </a>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
  </div>

  <p class="empty f-empty" data-f-empty="projects more" hidden>
    No project matches the current filter. <a href="#focus">Change the filter</a> to see more.
  </p>
</div>
