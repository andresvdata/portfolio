---
import { getCollection } from 'astro:content';
import { focusAttrs } from '../lib/focus';
const steps = (await getCollection('story')).sort((a, b) => a.data.order - b.data.order);
---

<ol class="story-grid" data-f-group>
  {steps.map((s) => (
    <li class="story-step" {...focusAttrs({ kind: 'story', topics: s.data.topics, tools: s.data.tools })}>
      <span class="period">{s.data.period}</span>
      <h3>{s.data.title}</h3>
      <span class="org">{s.data.org}</span>
      <p>{s.data.text}</p>
      <div class="stat-row">
        {s.data.stats.map((st) => (
          <div class="stat">
            <strong>{st.value}</strong>
            <span>{st.label}</span>
          </div>
        ))}
      </div>
    </li>
  ))}
</ol>
<p class="f-empty" data-f-empty="story" hidden>No role in this timeline matches the filter.</p>
<p class="throughline">Same pattern every time: fix manual, scattered data, then make sure people use it.</p>
