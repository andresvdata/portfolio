---
import { getCollection } from 'astro:content';
import { rich } from '../lib/text';
import { focusAttrs } from '../lib/focus';

const all = (await getCollection('credentials')).sort((a, b) => a.data.order - b.data.order);

const columns = [
  { title: 'Publications', kinds: ['publication'] },
  { title: 'Education and certificates', kinds: ['education', 'certificate'] },
  { title: 'Accomplishments', kinds: ['accomplishment'] },
] as const;
---

<div class="cred-grid">
  {columns.map((col) => (
    <section class="cred-col panel" aria-label={col.title} data-f-group>
      <h3>{col.title}</h3>
      <ul class="cred-list">
        {all
          .filter((c) => (col.kinds as readonly string[]).includes(c.data.kind))
          .map((c) => (
            <li class="cred" data-kind={c.data.kind} {...focusAttrs({ kind: 'credentials', topics: c.data.topics, from: [c.data.title], always: c.data.topics.length === 0 })}>
              <span class="t">{c.data.title}</span>
              <span class="m">{c.data.issuer} · {c.data.date}</span>
              {c.data.note && <span class="m" set:html={rich(c.data.note)} />}
              {c.data.href && (
                <a href={c.data.href} target="_blank" rel="noopener noreferrer">
                  {c.data.hrefLabel ?? 'View'}
                  <span class="sr-only"> for {c.data.title} (opens in a new tab)</span>
                </a>
              )}
            </li>
          ))}
      </ul>
    </section>
  ))}
</div>
