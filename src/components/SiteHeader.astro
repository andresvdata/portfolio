---
import ResumeButton from './ResumeButton.astro';
import { site } from '../config/site';
import { withBase } from '../lib/text';

const home = withBase('/');
const items = [
  ['overview', 'Overview'],
  ['story', 'Story'],
  ['projects', 'Projects'],
  ['skills', 'Skills'],
  ['experience', 'Experience'],
  ['credentials', 'Credentials'],
  ['contact', 'Contact'],
] as const;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={home} aria-label={`${site.name}, home`}>
      <span class="brand-mark" aria-hidden="true">{site.initials}</span>
      <span class="brand-name">{site.shortName}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul>
        {items.map(([id, label]) => (
          <li><a href={`${home}#${id}`} data-nav={id}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <ResumeButton variant="ghost" hideIfMissing />
    </div>
  </div>
</header>

<script>
  // Highlight the section being read. It uses scroll positions, not IntersectionObserver, because observers
  // ignore rootMargin inside cross-origin frames and then pick the wrong section.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
  const targets = links
    .map((a) => document.getElementById(a.dataset.nav ?? ''))
    .filter((el): el is HTMLElement => !!el);

  if (targets.length) {
    let locked = false;
    let unlockTimer = 0;
    let frame = 0;

    const mark = (id: string) => {
      links.forEach((a) => {
        if (a.dataset.nav === id) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    const compute = () => {
      frame = 0;
      if (locked) return;
      const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 88;
      const line = pad + 24; // a section counts as current once its top passes this line
      const doc = document.documentElement;
      let current = targets[0].id;
      if (window.innerHeight + window.scrollY >= doc.scrollHeight - 4) {
        current = targets[targets.length - 1].id; // the last section can never reach the line
      } else {
        for (const t of targets) if (t.getBoundingClientRect().top <= line) current = t.id;
      }
      mark(current);
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(compute);
    };
    const unlockSoon = () => {
      window.clearTimeout(unlockTimer);
      unlockTimer = window.setTimeout(() => {
        locked = false;
        schedule();
      }, 160);
    };

    // A click highlights its own link at once and holds it until the scroll that follows comes to rest.
    // If the page never scrolls (for example when it is embedded at full height), the click's choice stays.
    links.forEach((a) =>
      a.addEventListener('click', () => {
        locked = true;
        mark(a.dataset.nav!);
      }),
    );
    window.addEventListener(
      'scroll',
      () => {
        if (locked) unlockSoon();
        else schedule();
      },
      { passive: true },
    );
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('load', schedule);
    document.addEventListener('focus-change', schedule); // the page filter changes section heights
    schedule();
  }
</script>
