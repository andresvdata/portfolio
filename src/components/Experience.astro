---
import { getCollection } from 'astro:content';
import { formatYm } from '../lib/time';
import { rich, withBase } from '../lib/text';

const items = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const domainLabel = { bi: 'Business intelligence', research: 'Research data', engineering: 'Manufacturing engineering' } as const;
---

<div class="exp-grid">
  {items.map((e) => (
    <article class="exp" id={`exp-${e.id}`} data-domain={e.data.domain}>
      <div>
        <h3>{e.data.org}</h3>
        <span class="where">{e.data.location} · {domainLabel[e.data.domain]}</span>
      </div>

      {e.data.phases.map((p) => (
        <div class="phase">
          <strong>{p.role}</strong>
          <span class="when">
            {p.display ?? `${formatYm(p.start)} – ${formatYm(p.end)}`} · {p.kind}
          </span>
        </div>
      ))}

      <p class="mission" set:html={rich(e.data.mission)} />

      <ul class="points">
        {e.data.highlights.map((h) => <li set:html={rich(h.text)} />)}
      </ul>

      <div class="tag-row">
        {e.data.stack.map((s) => <span class="tag">{s}</span>)}
      </div>

      {e.data.project && (
        <a href={withBase(`/projects/${e.data.project}/`)}>
          Read the related case study<span aria-hidden="true"> →</span>
        </a>
      )}
    </article>
  ))}
</div>
